# Copy this file to `.env.local` and fill in what you need.
#
# With no DATABASE_URL the site runs in DEMO MODE: a built-in PostgreSQL
# database (PGlite) stored in ./.data/pglite, with sample content and two
# demo logins shown on the admin sign-in page. Nothing below is needed to
# try the demo on your computer.

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string, e.g. from Neon: Dashboard → Connect →
# "Connection string" (the pooled one is fine). Keep it secret.
DATABASE_URL=

# ── Admin sign-in ────────────────────────────────────────────────────────
# Secret used to sign admin sessions (at least 32 random characters).
# Required whenever DATABASE_URL is set. Generate one with either:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# First admin account. It is created on the first run only if the database
# has no admin yet; the password is stored hashed (scrypt). Use at least
# 8 characters with a letter and a number. After the first deploy you can
# delete ADMIN_PASSWORD from your settings and change the password in
# Admin → My account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Website ──────────────────────────────────────────────────────────────
# Public address of the site (no trailing slash), used for search results,
# the sitemap and link previews. Netlify and Vercel fill this in for you.
NEXT_PUBLIC_SITE_URL=

# ── Optional ─────────────────────────────────────────────────────────────
# Add sample bookings and enquiries when a new database is set up
# (default: true). Set to false for a clean live site.
SEED_SAMPLE_DATA=

# Apply database migrations automatically when the app starts
# (default: true). Set to false if you only want `npm run db:setup` to do it.
DB_AUTO_MIGRATE=

# Maximum database connections per server instance (default: 5).
DATABASE_POOL_MAX=

# Demo mode only: folder for the demo database, or "memory" to keep it in RAM.
PGLITE_DATA_DIR=
